@page "/activity/{Id:int}"
@attribute [Authorize]
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject ActivityApiClient ActivityApi
@using System.Security.Claims
@using System.Net

@if (!string.IsNullOrEmpty(errorMessage) && Activity is null)
{
    <p class="text-danger">@errorMessage</p>    
}

else if (Activity is not null)
{
    <h3>Activity</h3>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <p class="text-danger">@errorMessage</p>
    }

    <h3 class="kort-titel">@Activity.ActivityTitle</h3>

    <p class="kort-beskrivelse">@Activity.ActivityInfo</p>

    <div class="kort-deltagere">
        👥 Maks: @Activity.MaxParticipant deltagere  
    </div>

    <div class="kort-info">
        <span>📅 @Activity.ActivityStartTime.ToString("dd-MM-yyyy 'kl.' HH:mm")</span>
        <span>📍 @Activity.Address</span>
    </div>

    <AuthorizeView>
        <Authorized>
            @if (IsOwner(context.User))
            {
                <div class="container-button">
                    <button type="button" class="edit-delete-knap" @onclick="() => EditActivity(Activity.Id)"> Rediger aktivitet </button>
                </div>
            }

            @if (IsOwner(context.User) || context.User.IsInRole("Admin"))
            {
                <br />
                <div class="container-button">
                    <button type="button" class="edit-delete-knap" @onclick="() => DeleteActivity(Activity.Id)"> Slet aktivitet </button>
                </div>
            }
        </Authorized>
    </AuthorizeView>

}



@code {
    [Parameter]
    public int Id { get; set; }


    public game_match.Models.Activity? Activity { get; set; }

    private string? errorMessage = "";

    protected override async Task OnParametersSetAsync()
    {
        errorMessage = "";
        Activity = null;

        try
        {
            Activity = await ActivityApi.GetByIdAsync(Id);
        }
        catch (HttpRequestException ex)
        {
            if (ex.StatusCode == HttpStatusCode.NotFound)
            {
                errorMessage = $"Aktiviteten med id {Id} blev ikke fundet";
            }
            else if (ex.StatusCode is null)
            {
                errorMessage = "Kan ikke kontakte Api'et";
            }
            else
            {
                errorMessage = "Der opstod en fejl under hentningen af aktiviteten";
            }
        }

    }

    public async Task DeleteActivity(int id)
    {
        errorMessage = "";

        try
        {
            await ActivityApi.DeleteByIdAsync(id);
            NavigationManager.NavigateTo("/"); 
        }
        catch (HttpRequestException ex)
        {
            if (ex.StatusCode == HttpStatusCode.NotFound)
            {
                errorMessage = $"Aktiviteten med id {id} blev ikke fundet";
            }
            else if (ex.StatusCode is null)
            {
                errorMessage = "Kan ikke kontakte Api'et";
            }
            else
            {
                errorMessage = "Der opstod en fejl under sletningen af aktiviteten";
            }
        }


    }

    public async Task EditActivity(int id)
    {
        
        NavigationManager.NavigateTo($"/ActivityFormPage/{id}"); 

    }

    private bool IsOwner(ClaimsPrincipal user)
    {
        string? userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        return Activity != null && userId == Activity.OwnerId.ToString();
    }

}
