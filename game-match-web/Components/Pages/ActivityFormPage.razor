@page "/ActivityFormPage"
@page "/ActivityFormPage/{Id:int?}"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject IActivityService ActivityService
@inject ActivityApiClient ActivityApi
@inject AuthenticationStateProvider AuthStateProvider
@using System.Security.Claims
@attribute [Authorize]

@if (activity != null)
{
    <ActivityFormComponent Activity="@activity" OnSave="@HandleValidSubmitToDB"/>

}
      @if (!string.IsNullOrEmpty(errorMessage))
    {
        <p class="text-danger">@errorMessage</p>
    }



@code {
        [Parameter]
        public int? Id { get; set; }
    private string? errorMessage = "";
    private Activity? activity;


    protected override async Task OnInitializedAsync()
    {
        errorMessage = null;
        if (Id.HasValue)
        {
            try
            {
                activity = await ActivityApi.GetByIdAsync(Id.Value);
            }
                    catch (HttpRequestException ex)
        {
            if(ex.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                errorMessage = "Aktiviteten blev ikke fundet";
            }
            else
            {
                errorMessage = "Kunne ikke hente aktiviteten til redigering.";
            }
        }
    }
        else
        {
            AuthenticationState authState = await AuthStateProvider.GetAuthenticationStateAsync();
            ClaimsPrincipal user = authState.User;
            string? userIdString = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

            if (int.TryParse(userIdString, out int userId))
            {
                activity = ActivityService.CreateNewActivity(userId);
            }
            else
            {
                NavigationManager.NavigateTo("/Error");
            }
        }
    }

    private async Task HandleValidSubmitToDB(Activity activityToSave)
    {
        errorMessage = null;

        try
        {
            if(Id.HasValue)
            {
                await ActivityApi.EditByIdAsync(Id.Value, activityToSave);
            }
            else
            {
                await ActivityApi.AddAsync(activityToSave);   
            }

            NavigationManager.NavigateTo("/"); 
        }
        catch (HttpRequestException ex)
        {
            if(ex.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                errorMessage = "Aktiviteten blev ikke fundet";
            }
            else if (ex.StatusCode is null)
            {
                errorMessage = "Kan ikke kontakte API'et. Prøv igen.";
            }
            else
            {
                errorMessage = "Der opstod en fejl under gemning af aktiviteten.";
            }
        }
    }
}
