@page "/"
@rendermode InteractiveServer
@inject ActivityApiClient ActivityApi

<PageTitle>GameMatch - Aktiviteter</PageTitle>

<div class="aktiviteter-side">
    <div class="overskrift-linje">
        <h2 class="overskrift">Aktiviteter</h2>
        <input type="text" class="soegefelt" placeholder="Søg efter aktivitet..." 
               @oninput="OnSearchTextChanged" />
    </div>

    <MessageBox/>

    @if (loadError != "")
    {
        <p role="alert" class="text-danger">@loadError</p>
        <button @onclick="OnInitializedAsync">Hent igen</button>
    }
    else if (activities.Count == 0)
    {
        <p class="Ingen-aktiviteter">Ingen aktivitets opslag tilgængelig</p>
    }
    else if (filteredActivities.Count == 0)
    {
        <p class="Ingen-aktiviteter"> Ingen aktiviteter matcher "@searchText"</p>
    }
    else
    {
        <div class="kort-gitter">
            @foreach (var activity in filteredActivities)
            {
                <ActivityCard Activity="activity" />
            }
        </div>
    }
</div>

@code {
    private List<Activity> activities = new();
    private List<Activity> filteredActivities = new(); //Listen der vises
    private string searchText = ""; //Søgeinput
    private string loadError = "";
    // protected override async void OnInitialized()
    protected override async Task OnInitializedAsync()
    {
        loadError = "";
        //Her kalder vi api for at få listen 
        try
        {
            activities = await ActivityApi.GetAllAsync();
            filteredActivities = activities;
        }
        catch (HttpRequestException)
        {
            loadError = "Kan ikke hente fra API. Prøv igen.";
        }
        catch (OperationCanceledException)
        {
            loadError = "Apiet svarede ikke i tide";
        }

    }
    //Kaldes hver gang brugeren skriver i søge feltet. Se evt. Blazorundervisning dag 3 slide 37.
    private void OnSearchTextChanged(ChangeEventArgs e)
    {
        searchText = e.Value?.ToString() ?? string.Empty;
        filteredActivities = activities
            .Where(a => a.ActivityTitle.Contains(searchText, StringComparison.OrdinalIgnoreCase)
                     || a.ActivityInfo.Contains(searchText, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }
}