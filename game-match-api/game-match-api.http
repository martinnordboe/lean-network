@game_match_api_HostAddress = http://localhost:5196

//Hent alle aktiviter
GET {{game_match_api_HostAddress}}/api/activities
Accept: application/json

###

//Hent en aktivitet der ikke findes
GET {{game_match_api_HostAddress}}/api/activities/49
Accept: application/json

###

//Hent en aktivitet der eksisterer
GET {{game_match_api_HostAddress}}/api/activities/49
Accept: application/json

###

//Slet aktivitet: forvent 204. Ret id
DELETE {{game_match_api_HostAddress}}/api/activities/999998

###

//Slet aktivitet der ikke eksisterer: forvent 404
DELETE {{game_match_api_HostAddress}}/api/activities/999999

###

//Opret aktivitet med ugyldigt input: forvent 400
POST {{game_match_api_HostAddress}}/api/activities
Content-Type: application/json

{ "ownerId": 1, "activityTitle": "", "activityInfo": "Info", "address": "Testvej 1", "activityStartTime": "2026-12-01T18:00:00", "maxParticipant": 0 }

###

//Opret aktivitet med gyldigt input: forvent 201 (owner id skal findes)
POST {{game_match_api_HostAddress}}/api/activities
Content-Type: application/json

{ "ownerId": 1, "activityTitle": "Test", "activityInfo": "Info", "address": "Testvej 1", "activityStartTime": "2026-12-01T18:00:00", "maxParticipant": 5 }