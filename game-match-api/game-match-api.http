// 01. Log ind som admin. Forvent 200.
POST {{game_match_api_HostAddress}}/api/account/login
Content-Type: application/x-www-form-urlencoded

username={{username}}&password={{password}}

###

// 02. Hent listen før oprettelse. Forvent 200.
GET {{game_match_api_HostAddress}}/api/activities
Accept: application/json

###

// 03. Hent en eksisterende aktivitet. Forvent 200.
GET {{game_match_api_HostAddress}}/api/activities/{{activityId}}
Accept: application/json

###

// 04. Forsøg at oprette en aktivitet med ugyldige felter. Forvent 400 som er bad request og der er ugyldige felter i forhold til vores [required]
POST {{game_match_api_HostAddress}}/api/activities
Content-Type: application/json
Cookie: .GameMatch.Session={{sessionCookie}}

{ "ownerId": 1, "activityTitle": "", "activityInfo": "Info", "address": "Testvej 1", "activityStartTime": "2026-12-01T18:00:00", "maxParticipant": 0 }

###

// 05. Opret en aktivitet med gyldige felter og et eksisterende ownerId. Forvent 201 som er created statuskode
POST {{game_match_api_HostAddress}}/api/activities
Content-Type: application/json
Cookie: .GameMatch.Session={{sessionCookie}}

{ "ownerId": 1, "activityTitle": "Test", "activityInfo": "Info", "address": "Testvej 1", "activityStartTime": "2026-12-01T18:00:00", "maxParticipant": 5 }

###

// 06. Forsøg at logge ind med en bruger der ikke eksisterer. Forvent 401 unauthorized
POST {{game_match_api_HostAddress}}/api/account/login
Content-Type: application/x-www-form-urlencoded

username=djwidajdioawdwjdoiadoiajdoiw&password=dwdwaidjawiodjawidddwhd

###

// 07. Kald et beskyttet endpoint med en ugyldig session. Forvent 401.
DELETE {{isolatedApiHostAddress}}/api/activities/{{missingActivityId}}
Cookie: .GameMatch.Session=jdwpdjwjdiwj

###

// 08. Log ind som en almindelig bruger uden adminrollen. Forvent 200.
POST {{game_match_api_HostAddress}}/api/account/login
Content-Type: application/x-www-form-urlencoded

username={{otherUsername}}&password={{otherPassword}}

###

// 09. Forsøg at rette en eksisterende testaktivitet, som den anden bruger ikke ejer. Forvent 403.
PUT {{game_match_api_HostAddress}}/api/activities/{{protectedTestActivityId}}
Content-Type: application/json
Cookie: .GameMatch.Session={{otherSessionCookie}}

{ "activityTitle": "Test af redigeringsadgang", "activityInfo": "Test", "address": "Testvej 1", "activityStartTime": "2026-12-01T18:00:00", "maxParticipant": 5 }

###

// 10. Forsøg at slette samme aktivitet som den almindelige bruger. Forvent 403.
DELETE {{game_match_api_HostAddress}}/api/activities/{{protectedTestActivityId}}
Cookie: .GameMatch.Session={{otherSessionCookie}}

###

// 11. Hent en aktivitet, der ikke findes. Forvent 404.
GET {{game_match_api_HostAddress}}/api/activities/{{missingActivityId}}
Accept: application/json

###

// 12. Forsøg at slette et id, der ikke findes, med den almindelige brugers session. Forvent 404.
DELETE {{game_match_api_HostAddress}}/api/activities/{{missingActivityId}}
Cookie: .GameMatch.Session={{otherSessionCookie}}

###

// 13. Log ind som admin. Forvent 200.
POST {{game_match_api_HostAddress}}/api/account/login
Content-Type: application/x-www-form-urlencoded

username={{username}}&password={{password}}

###

// 14. Ret en testaktivitet, som admin selv ejer. Forvent 204.
PUT {{game_match_api_HostAddress}}/api/activities/{{testActivityId}}
Content-Type: application/json
Cookie: .GameMatch.Session={{sessionCookie}}

{ "activityTitle": "Testaktivitet opdateret af admin", "activityInfo": "Opdateret i HTTP-testen", "address": "Testvej 1", "activityStartTime": "2026-12-01T18:00:00", "maxParticipant": 8 }

###

// 15. Ryd op ved at slette testaktiviteten. Forvent 204.
DELETE {{game_match_api_HostAddress}}/api/activities/{{testActivityId}}
Cookie: .GameMatch.Session={{sessionCookie}}
