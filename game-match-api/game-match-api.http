@game_match_api_HostAddress = http://localhost:5196

//Hent alle aktiviter
GET {{game_match_api_HostAddress}}/api/activities
Accept: application/json

###

//Hent en aktivitet der ikke findes
GET {{game_match_api_HostAddress}}/api/activities/999999
Accept: application/json

###

//Hent en aktivitet der eksisterer
GET {{game_match_api_HostAddress}}/api/activities/49
Accept: application/json

###

//Forkert login: forvent 401
POST {{game_match_api_HostAddress}}/auth/login
Content-Type: application/json

{ "username": "findesikke", "password": "forkert" }

###

//Manglende kodeord: forvent 401
POST {{game_match_api_HostAddress}}/auth/login
Content-Type: application/json

{ "username": "findesikke" }

